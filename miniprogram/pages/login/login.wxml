<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">用户登录</text>
  </view>
  
  <!-- 登录表单 -->
  <view class="login-form">
    <!-- 账号输入 -->
    <view class="form-item">
      <view class="form-label">账号</view>
      <input 
        class="form-input" 
        placeholder="请输入用户名或昵称" 
        placeholder-style="color: rgba(255,255,255,0.6)" 
        value="{{username}}" 
        bindinput="onUsernameChange"
      ></input>
    </view>
    
    <!-- 密码输入 -->
    <view class="form-item">
      <view class="form-label">密码</view>
      <view class="password-input-container">
        <input 
          class="form-input password-input" 
          placeholder="请输入密码" 
          placeholder-style="color: rgba(255,255,255,0.6)" 
          value="{{password}}" 
          bindinput="onPasswordChange"
          password
        ></input>
        <view class="password-toggle" bindtap="togglePasswordVisible">
          <text style="font-size:24rpx;">{{passwordVisible ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
    </view>
    
    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="login">登录</button>
    
    <!-- 忘记密码 -->
    <view class="forgot-password" bindtap="goForgotPassword">
      <text>忘记密码？</text>
    </view>
    
    <!-- 注册链接 -->
    <view class="register-link">
      <text>还没有账号？</text>
      <text class="register-btn" bindtap="goRegister">立即注册</text>
    </view>
  </view>
</view>