/* myOrders.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 100rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
}

/* 页面标题 */
.page-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.header-left {
  width: 60rpx;
  display: flex;
  justify-content: flex-start;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
  text-align: center;
}

.header-right {
  width: 60rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.2);
  margin: 10rpx 0;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
  overflow: hidden;
  
}

.tab-item {
  flex: 1;
  padding: 24rpx 30rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  transition: all 0.3s ease;
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
  min-width: 120rpx;
}

.tab-item:last-child {
  border-right: none;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-weight: bold;
}

/* 订单列表 */
.order-list {
  margin: 20rpx 0;
  border-radius: 16rpx;
  min-height: 600rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 20rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
}

/* 订单项 */
.order-item {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.order-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.order-status {
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.pending {
  background: rgba(255, 193, 7, 0.3);
  color: #ffc107;
}

.order-status.confirmed {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
}

.order-status.completed {
  background: rgba(76, 175, 80, 0.3);
  color: #4caf50;
}

.order-status.cancelled {
  background: rgba(158, 158, 158, 0.3);
  color: #9e9e9e;
}

/* 物品信息 */
.item-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-detail {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-price {
  font-size: 32rpx;
  color: #f1c40f;
  font-weight: bold;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.user-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 4rpx;
}

.user-role {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.exchange-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 0 20rpx;
}

/* 交易信息 */
.exchange-info {
  display: flex;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-right: 10rpx;
}

.info-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 订单操作 */
.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  border: none;
  padding: 0;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3498db, #2980b9);
  color: #fff;
}

.action-btn::after {
  border: none;
}

/* 订单时间 */
.order-time {
  margin-top: 16rpx;
  text-align: right;
}

.order-time text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
