.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  background: white;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left, .header-right {
  width: 80rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.rate-content {
  padding: 20rpx;
}

.info-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.item-info {
  display: flex;
  align-items: center;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-detail {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.item-price {
  font-size: 32rpx;
  color: #e74c3c;
  font-weight: bold;
}

.rate-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.rate-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 24rpx;
}

.target-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.target-info {
  margin-left: 20rpx;
}

.target-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  display: block;
}

.target-role {
  font-size: 24rpx;
  color: #999;
}

.star-section {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.star-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.star-container {
  display: flex;
}

.star {
  font-size: 48rpx;
  margin-right: 10rpx;
  cursor: pointer;
  transition: color 0.2s;
}

.rating-text {
  font-size: 28rpx;
  color: #f5a623;
  font-weight: bold;
  margin-left: 20rpx;
}

.comment-section {
  margin-bottom: 24rpx;
}

.comment-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 30rpx;
  font-weight: bold;
}

.submit-btn:active {
  opacity: 0.8;
}

.tips-card {
  background: #fff9e6;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #ffe082;
}

.tips-title {
  font-size: 28rpx;
  color: #f57c00;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.tips-list {
  font-size: 24rpx;
  color: #f57c00;
  line-height: 2;
}