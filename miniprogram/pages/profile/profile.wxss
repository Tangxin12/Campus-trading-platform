/* profile.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  padding: 0 0 100rpx;
  position: relative;
  overflow: hidden;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  position: sticky;
  top: 0;
  z-index: 100;
  margin: 0 -24rpx;
  width: calc(100% + 48rpx);
}

.header-left,
.header-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.header-left {
  justify-content: flex-start;
}

.header-right {
  justify-content: flex-end;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  flex: 1;
  text-align: center;
}

/* 头像部分 */
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.avatar-container {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  position: relative;
  cursor: pointer;
  transition: all 0.3s ease;
}

.avatar-container:active {
  transform: scale(0.95);
}

.avatar-container image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-edit-btn {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(52, 152, 219, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.avatar-edit-btn:active {
  background: rgba(52, 152, 219, 1);
  transform: scale(1.1);
}

/* 信息部分 */
.info-section,
.verification-section {
  margin: 16rpx 0;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 信息项 */
.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-input {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-left: 20rpx;
}

.info-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

/* 认证部分 */
.verification-status {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}

.status-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.status-value {
  font-size: 24rpx;
  color: #2ecc71;
  font-weight: 500;
  margin-left: 12rpx;
}

.status-value.unverified {
  color: #f39c12;
}

.verification-tips {
  margin-bottom: 24rpx;
}

.tips-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}

.verification-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  border: none;
  border-radius: 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
}

.verification-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(52, 152, 219, 0.3);
}

.verification-btn.verified {
  background: rgba(46, 204, 113, 0.2);
  border: 1rpx solid rgba(46, 204, 113, 0.4);
  color: #2ecc71;
  box-shadow: none;
}

.verification-btn.verified:active {
  background: rgba(46, 204, 113, 0.3);
}

/* 保存按钮 */
.save-section {
  margin: 30rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  border: none;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(52, 152, 219, 0.3);
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(52, 152, 219, 0.3);
}

/* 适配不同屏幕 */
@media screen and (max-width: 375px) {
  .info-section,
  .verification-section {
    margin: 12rpx 0;
    padding: 20rpx;
  }
  
  .avatar-container {
    width: 140rpx;
    height: 140rpx;
  }
  
  .info-label {
    width: 100rpx;
    font-size: 24rpx;
  }
  
  .info-input {
    font-size: 24rpx;
  }
  
  .save-section {
    margin: 24rpx 0;
  }
  
  .page-header {
    margin: 0 0;
    width: 100%;
    padding: 30rpx 20rpx;
  }
}