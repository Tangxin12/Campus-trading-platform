/* index.wxss */
.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  padding: 0 20rpx;
}

/* 背景渐变 */
.background-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #3498db 0%, #9b59b6 100%);
  z-index: -1;
}

/* 装饰元素 */
.decor-element {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(50rpx);
  animation: float 6s ease-in-out infinite;
}

.decor-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  left: -100rpx;
  animation-delay: 0s;
}

.decor-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: -50rpx;
  right: -50rpx;
  animation-delay: 2s;
}

.decor-3 {
  width: 200rpx;
  height: 200rpx;
  top: 50%;
  right: 10%;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-20rpx) rotate(10deg);
  }
}

/* 磨砂玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx 0 rgba(31, 38, 135, 0.37);
  transition: all 0.3s ease;
}

.glass-effect:hover {
  box-shadow: 0 12rpx 40rpx 0 rgba(31, 38, 135, 0.45);
  transform: translateY(-2rpx);
}

/* 顶部导航 */
.top-nav {
  margin: 20rpx 0;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.nav-left {
  flex: 0 0 auto;
}

.app-logo {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.15);
}

.logo-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.nav-center {
  flex: 1;
  margin: 0 10rpx;
}

.search-box {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.search-box:focus-within {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-box input {
  flex: 1;
  font-size: 24rpx;
  margin-left: 12rpx;
  color: #fff;
}

.search-btn {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  cursor: pointer;
  transition: all 0.3s ease;
}

.search-btn:hover {
  background: rgba(255, 255, 255, 0.4);
  transform: translateY(-2rpx);
}

.nav-right {
  flex: 0 0 auto;
}

.location {
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  transition: all 0.3s ease;
}

.location:hover {
  background: rgba(255, 255, 255, 0.25);
}

.location icon {
  margin: 0 4rpx;
}

/* 分类入口 */
.category-nav {
  margin: 0 0 20rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 10rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-right: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 100rpx;
}

.category-item:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-4rpx);
}

.category-item.active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-weight: bold;
}

.category-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.category-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

/* 核心推荐区 */
.core-recommend {
  margin: 0 0 20rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 轮播图 */
.swiper-container {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.swiper-container swiper {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.swiper-container image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.swiper-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  border-radius: 0 0 16rpx 16rpx;
}

.swiper-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.swiper-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 通用样式 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  transition: all 0.3s ease;
}

.section-more:hover {
  color: #fff;
}

/* 热门置换 */
.hot-section {
  margin-bottom: 20rpx;
}

/* 猜你喜欢 */
.recommend-section {
  margin-bottom: 20rpx;
}

/* 推荐标签 */
.recommend-tabs {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 4rpx;
}

.recommend-tab {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.recommend-tab.active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-weight: bold;
}

.hot-scroll {
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 10rpx;
}

.hot-item {
  display: inline-block;
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.3s ease;
  position: relative;
  cursor: pointer;
}

.hot-item:hover {
  transform: scale(1.05);
}

.hot-item image {
  width: 100%;
  height: 100%;
}

.hot-item-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  border-radius: 0 0 16rpx 16rpx;
}

.hot-item-count {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

/* 功能快捷入口 */
.quick-entry {
  margin: 0 0 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.entry-item {
  flex: 1;
  text-align: center;
}

.entry-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  margin: 0 12rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.entry-icon:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: translateY(-5rpx);
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

.icon-circle::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
}

.add-circle {
  background: linear-gradient(135deg, rgba(52, 152, 219, 0.6), rgba(155, 89, 182, 0.6));
}

.star-circle {
  background: linear-gradient(135deg, rgba(241, 196, 15, 0.6), rgba(243, 156, 18, 0.6));
}

.search-circle {
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.6), rgba(26, 188, 156, 0.6));
}

.activity-circle {
  background: linear-gradient(135deg, rgba(231, 76, 60, 0.6), rgba(230, 126, 34, 0.6));
}

.entry-icon text {
  font-size: 20rpx;
  color: #fff;
}

/* 置换物品列表区 */
.exchange-list {
  margin: 0 0 100rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.filter-buttons {
  display: flex;
  align-items: center;
}

.filter-btn {
  padding: 10rpx 20rpx;
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
}

.filter-btn:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: translateY(-2rpx);
}

.filter-btn icon {
  margin-left: 8rpx;
  transition: transform 0.3s ease;
}

.filter-btn:hover icon {
  transform: rotate(180deg);
}

/* 物品列表 */
.goods-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 空状态提示 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.9);
}

.empty-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.goods-item {
  width: calc(50% - 10rpx);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  cursor: pointer;
}

.goods-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.goods-item > image {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx 16rpx 0 0;
  transition: transform 0.3s ease;
}

.goods-item:hover > image {
  transform: scale(1.05);
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #fff;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  margin-bottom: 12rpx;
}

.goods-price {
  color: #ffeb3b;
  font-weight: bold;
  font-size: 22rpx;
}

.goods-stats {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
}

.goods-stats icon {
  margin-right: 4rpx;
  margin-left: 12rpx;
}

.goods-stats icon:first-child {
  margin-left: 0;
}

.goods-stat-text {
  margin-right: 4rpx;
}

.goods-publisher {
  display: flex;
  align-items: center;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.publisher-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  display: block;
  background-color: rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.publisher-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 8rpx;
}

.publisher-time {
  white-space: nowrap;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  font-size: 22rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.load-more:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: translateY(-2rpx);
}

.load-more icon {
  margin-left: 8rpx;
  animation: spin 1s linear infinite;
}

/* 适配 iPhone X 等刘海屏 */
@media screen and (device-height: 812px) {
  .container {
    padding-bottom: 40rpx;
  }
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #fff;
}

.loading::after {
  content: '';
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-left: 12rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

