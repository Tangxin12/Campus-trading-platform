<view class="container">
  
  <!-- 通知分类 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'system' ? 'active' : ''}}" bindtap="switchTab" data-tab="system">
      <text>系统通知</text>
    </view>
    <view class="tab-item {{activeTab === 'trade' ? 'active' : ''}}" bindtap="switchTab" data-tab="trade">
      <text>交易通知</text>
    </view>
    <view class="tab-item {{activeTab === 'interact' ? 'active' : ''}}" bindtap="switchTab" data-tab="interact">
      <text>互动通知</text>
    </view>
  </view>
  
  <!-- 通知列表 -->
  <scroll-view class="notification-list" scroll-y="true">
    <!-- 系统通知 -->
    <view wx:if="{{activeTab === 'system'}}">
      <view class="notification-item" wx:for="{{systemNotifications}}" wx:key="id">
        <view class="notification-icon system-icon">
          <text style="font-size:28rpx;">{{item.icon}}</text>
        </view>
        <view class="notification-content">
          <view class="notification-title">{{item.title}}</view>
          <view class="notification-message">{{item.message}}</view>
          <view class="notification-time">{{item.time}}</view>
        </view>
        <view class="notification-badge" wx:if="{{!item.read}}">
          <view class="badge-dot"></view>
        </view>
      </view>
      <view wx:if="{{systemNotifications.length === 0}}" class="empty-state">
        <text style="font-size:60rpx;">📢</text>
        <text class="empty-text">暂无系统通知</text>
      </view>
    </view>
    
    <!-- 交易通知 -->
    <view wx:if="{{activeTab === 'trade'}}">
      <view class="notification-item" wx:for="{{tradeNotifications}}" wx:key="id">
        <view class="notification-icon trade-icon">
          <text style="font-size:28rpx;">{{item.icon}}</text>
        </view>
        <view class="notification-content">
          <view class="notification-title">{{item.title}}</view>
          <view class="notification-message">{{item.message}}</view>
          <view class="notification-time">{{item.time}}</view>
        </view>
        <view class="notification-badge" wx:if="{{!item.read}}">
          <view class="badge-dot"></view>
        </view>
      </view>
      <view wx:if="{{tradeNotifications.length === 0}}" class="empty-state">
        <text style="font-size:60rpx;">💰</text>
        <text class="empty-text">暂无交易通知</text>
      </view>
    </view>
    
    <!-- 互动通知 -->
    <view wx:if="{{activeTab === 'interact'}}">
      <view class="notification-item" wx:for="{{interactNotifications}}" wx:key="id">
        <view class="notification-icon interact-icon">
          <text style="font-size:28rpx;">{{item.icon}}</text>
        </view>
        <view class="notification-content">
          <view class="notification-title">{{item.title}}</view>
          <view class="notification-message">{{item.message}}</view>
          <view class="notification-time">{{item.time}}</view>
        </view>
        <view class="notification-badge" wx:if="{{!item.read}}">
          <view class="badge-dot"></view>
        </view>
      </view>
      <view wx:if="{{interactNotifications.length === 0}}" class="empty-state">
        <text style="font-size:60rpx;">🤝</text>
        <text class="empty-text">暂无互动通知</text>
      </view>
    </view>
  </scroll-view>
</view>