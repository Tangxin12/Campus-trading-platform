.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 100rpx;
}

.page-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 20rpx 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  margin: 20rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 32rpx 20rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 30rpx;
  transition: all 0.3s ease;
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tab-item:last-child {
  border-right: none;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-weight: bold;
}

.notification-list {
  margin: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  min-height: 600rpx;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: background 0.3s ease;
}

.notification-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.notification-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.system-icon {
  background: rgba(255, 193, 7, 0.2);
  color: #ffc107;
}

.trade-icon {
  background: rgba(40, 167, 69, 0.2);
  color: #28a745;
}

.interact-icon {
  background: rgba(0, 123, 255, 0.2);
  color: #007bff;
}

.notification-content {
  flex: 1;
}

.notification-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.notification-message {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.notification-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.notification-badge {
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #dc3545;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 20rpx;
}