<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-left" bindtap="goBack">
        <image src="/images/fh.png" mode="aspectFill" style="width: 28rpx; height: 28rpx;"></image>
    </view>
    <text class="page-title">我的收藏</text>
    <view class="header-right"></view>
  </view>
  
  <!-- 收藏列表 -->
  <scroll-view class="collection-list" scroll-y="true">
    <block wx:if="{{collections.length === 0}}">
      <view class="empty-state">
        <text style="font-size:60rpx;">💜</text>
        <text class="empty-text">暂无收藏</text>
        <text class="empty-subtext">收藏喜欢的物品，方便随时查看</text>
      </view>
    </block>
    <block wx:else>
      <view class="collection-item" wx:for="{{collections}}" wx:key="_id">
        <view class="item-image">
          <!-- 直接用转换后的临时URL显示图片 -->
          <image 
            src="{{item.imageUrl || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=product%20placeholder%20image&image_size=square'}}" 
            mode="aspectFill"
            lazy-load="true"></image>
        </view>
        <view class="item-info">
          <view class="item-name">{{item.itemName || item.name}}</view>
          <view class="item-price">¥{{item.itemPrice || item.price || 0}}</view>
          <view class="item-meta">
            <text class="item-publisher">{{item.publisher}}</text>
            <text class="item-time">{{formatTime(item.createdAt)}}</text>
          </view>
        </view>
        <view class="item-actions">
          <view class="action-btn" bindtap="viewItemDetail" data-id="{{item.itemId || item._id}}">
            <text style="font-size:24rpx;">🔍</text>
          </view>
          <view class="action-btn" bindtap="uncollectItem" data-id="{{item.itemId || item._id}}">
            <text style="font-size:24rpx;">💔</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>