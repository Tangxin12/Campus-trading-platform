/* detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  padding-bottom: 120rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.back-arrow {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  margin-left: -6rpx;
  line-height: 1;
}

/* 图片轮播 */
.swiper-container {
  height: 500rpx;
  width: 100%;
  overflow: hidden;
  position: relative;
}

.swiper-container swiper {
  height: 100%;
  width: 100%;
}

.swiper-container image {
  width: 100%;
  height: 100%;
  border-radius: 0;
  transition: transform 0.3s ease;
}

.swiper-container image:active {
  transform: scale(1.05);
}

/* 玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
  padding: 28rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
  transition: all 0.3s ease;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.glass-effect:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(31, 38, 135, 0.2);
}

/* 物品信息 */
.item-info {
  margin-top: -60rpx;
  border-radius: 40rpx 40rpx 24rpx 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.item-title-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.item-category {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.item-condition {
  display: inline-block;
  background: linear-gradient(135deg, #f39c12, #e67e22);
  padding: 8rpx 20rpx;
  border-radius: 25rpx;
  font-size: 22rpx;
  font-weight: bold;
  align-self: flex-start;
  box-shadow: 0 4rpx 12rpx rgba(243, 156, 18, 0.3);
  margin-bottom: 20rpx;
}

.item-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #f1c40f;
  margin: 20rpx 0;
  text-shadow: 0 2rpx 4rpx rgba(241, 196, 15, 0.3);
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 36rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.item-campus {
  display: flex;
  align-items: center;
}

.item-time {
  display: flex;
  align-items: center;
}

.item-description,
.item-expected,
.item-exchange {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.description-content,
.expected-content,
.exchange-content {
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.9;
  padding-left: 20rpx;
}

/* 发布者信息 */
.publisher-info {
  margin-top: 0;
  margin-bottom: 20rpx;
}

.publisher-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.publisher-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.publisher-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.publisher-details {
  flex: 1;
}

.publisher-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.95);
}

.publisher-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.campus-verified {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(46, 204, 113, 0.3);
}

.publisher-stats {
  font-size: 22rpx;
  opacity: 0.8;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.follow-btn {
  background: linear-gradient(135deg, rgba(52, 152, 219, 0.8), rgba(155, 89, 182, 0.8));
  padding: 14rpx 40rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 255, 0.3);
  transition: all 0.3s ease;
}

.follow-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(52, 152, 219, 0.3);
}

.follow-btn.following {
  background: rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

/* 兑换须知 */
.exchange-notice {
  margin-top: 0;
  margin-bottom: 120rpx;
}

.notice-content {
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.85;
}

.notice-content text {
  display: block;
  margin-bottom: 14rpx;
  padding-left: 16rpx;
  position: relative;
}

.notice-content text::before {
  content: '⚠️';
  position: absolute;
  left: -8rpx;
  top: 0;
  font-size: 20rpx;
}

/* 核心操作区 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  margin: 0;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  margin: 0 12rpx;
  transition: all 0.3s ease;
  padding: 12rpx 0;
  border-radius: 20rpx;
}

.action-item:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.action-item icon {
  margin-bottom: 8rpx;
  transition: transform 0.3s ease;
}

.action-item:active icon {
  transform: scale(1.1);
}

.action-primary {
  flex: 2.5;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-left: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(52, 152, 219, 0.4);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.action-primary:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(52, 152, 219, 0.4);
}

/* 适配不同屏幕 */
@media screen and (max-width: 375px) {
  .item-title {
    font-size: 32rpx;
  }
  
  .item-price {
    font-size: 42rpx;
  }
  
  .action-bar {
    padding: 16rpx 20rpx;
  }
  
  .action-primary {
    padding: 20rpx;
    font-size: 26rpx;
  }
  
  .glass-effect {
    margin: 0 16rpx;
    padding: 24rpx;
    width: calc(100% - 32rpx);
  }
  
  .item-info {
    margin-bottom: 16rpx;
  }
  
  .publisher-info {
    margin-bottom: 16rpx;
  }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  text-align: center;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.9);
}

.empty-desc {
  font-size: 24rpx;
  opacity: 0.8;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading text {
  font-size: 24rpx;
  margin-right: 12rpx;
  opacity: 0.8;
}

.loading icon {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}