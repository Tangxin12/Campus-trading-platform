<view class="container">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-arrow">‹</text>
  </view>
  
  <!-- 物品图片轮播 -->
  <view class="swiper-container">
    <swiper autoplay="false" indicator-dots="true" indicator-active-color="#fff" circular="true">
      <!-- 修复：item 改为 img，绑定 data-src 传递图片链接 -->
      <swiper-item wx:for="{{item.images || [item.image]}}" wx:key="index" wx:for-item="img">
          <image src="{{img}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image>
        </swiper-item>
    </swiper>
  </view>
  
  <!-- 物品基础信息 -->
  <view class="item-info glass-effect">
    <!-- 物品名称和品类 -->
    <view class="item-title-section">
      <view class="item-title">{{item.name}}</view>
      <view class="item-category">{{item.category}}</view>
      <view class="item-condition">{{item.condition || '9成新'}}</view>
    </view>
    
    <!-- 物品价格 -->
    <view class="item-price">¥{{item.price}}</view>
    
    <!-- 发布信息 -->
    <view class="item-meta">
      <view class="item-campus">{{item.campus}}</view>
      <view class="item-time">{{item.createdAt || '2026-02-21'}}</view>
    </view>
    
    <!-- 物品描述 -->
    <view class="item-description">
      <view class="section-title">物品描述</view>
      <view class="description-content">{{item.description}}</view>
    </view>
    
    <!-- 期望置换物品 -->
    <view class="item-expected">
      <view class="section-title">期望置换</view>
      <view class="expected-content">{{item.expectedItem || '无'}}</view>
    </view>
    
    <!-- 置换方式 -->
    <view class="item-exchange">
      <view class="section-title">置换方式</view>
      <view class="exchange-content">{{item.exchangeMethod || '校园内当面交换'}}</view>
    </view>
  </view>
  
  <!-- 发布者信息 -->
  <view class="publisher-info glass-effect">
    <view class="publisher-header">
      <view class="publisher-avatar">
        <image src="{{item.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=user%20avatar%20placeholder%20circular%20portrait&image_size=square'}}"></image>
      </view>
      <view class="publisher-details">
        <view class="publisher-name">{{item.publisher || '匿名用户'}}</view>
        <view class="publisher-meta">
          <view class="campus-verified">{{item.college || '未设置学院'}}</view>
        </view>
      </view>
      <view class="follow-btn {{isFollowing ? 'following' : ''}}" bindtap="followPublisher">
        <text>{{isFollowing ? '已关注' : '关注'}}</text>
      </view>
    </view>
  </view>
  
  <!-- 兑换须知 -->
  <view class="exchange-notice glass-effect">
    <view class="section-title">兑换须知</view>
    <view class="notice-content">
      <text>平台置换规则提示:请当面验货后确认交换</text>
      <text>校园置换防坑提醒:注意保护个人信息,选择公共场所交易</text>
    </view>
  </view>
  
  <!-- 核心操作区 -->
  <view class="action-bar glass-effect">
    <view class="action-item" bindtap="collectItem">
      <text style="font-size:28rpx;">{{isCollected ? '⭐' : '☆'}}</text>
      <text>{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-primary" bindtap="contactPublisher">
      <text>立即沟通</text>
    </view>
  </view>
</view>