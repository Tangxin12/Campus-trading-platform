/* register.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  padding: 60rpx 24rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 注册表单 */
.register-form {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

/* 表单项目 */
.form-item {
  margin-bottom: 28rpx;
}

/* 表单标签 */
.form-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 表单输入框 */
.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #3498db;
  box-shadow: 0 0 0 2rpx rgba(52, 152, 219, 0.3);
}

/* 验证码输入容器 */
.verification-code-container {
  display: flex;
  gap: 16rpx;
}

.verification-code-input {
  flex: 1;
}

.verification-code-btn {
  width: 200rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  color: rgba(255, 255, 255, 0.95);
  font-size: 22rpx;
  transition: all 0.3s ease;
}

.verification-code-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.98);
}

.verification-code-btn:disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
  border-color: rgba(255, 255, 255, 0.2);
}

/* 密码输入容器 */
.password-input-container {
  position: relative;
}

.password-input {
  padding-right: 80rpx;
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.password-toggle:active {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) scale(0.95);
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #3498db, #2980b9);
  border: none;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
}

.register-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(52, 152, 219, 0.3);
}

/* 登录链接 */
.login-link {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}

.login-link text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-btn {
  color: #3498db !important;
  font-weight: 500;
  transition: color 0.3s ease;
}

.login-btn:active {
  color: #2980b9 !important;
}

/* 用户协议 */
.user-agreement {
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.user-agreement checkbox-group {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.user-agreement checkbox {
  margin-right: 8rpx;
  transform: scale(0.8);
}

.user-agreement text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.agreement-link {
  color: #3498db !important;
  transition: color 0.3s ease;
}

.agreement-link:active {
  color: #2980b9 !important;
}

/* 适配不同屏幕 */
@media screen and (max-width: 375px) {
  .container {
    padding: 40rpx 20rpx;
  }
  
  .page-title {
    font-size: 36rpx;
  }
  
  .register-form {
    padding: 24rpx;
  }
  
  .form-input {
    height: 80rpx;
  }
  
  .verification-code-btn {
    width: 180rpx;
    height: 80rpx;
    font-size: 20rpx;
  }
  
  .register-btn {
    height: 80rpx;
    font-size: 28rpx;
  }
  
  .user-agreement text {
    font-size: 18rpx;
  }
}
