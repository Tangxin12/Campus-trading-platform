/* publish.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  padding-bottom: 100rpx;
  position: relative;
  overflow: hidden;
}

/* 页面标题 */


.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
}

/* 章节 */
.section {
  margin: 20rpx;
  width: calc(100% - 40rpx);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
}

/* 章节标题 */
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-title text {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
}

.required {
  color: #ff6b6b;
  font-size: 28rpx;
  margin-left: 8rpx;
}

/* 表单项目 */
.form-item {
  margin-bottom: 28rpx;
}

/* 表单标签 */
.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 表单输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 表单文本域 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  line-height: 1.5;
}

.form-textarea::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 表单提示 */
.form-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

/* 图片上传容器 */
.upload-container {
  margin-top: 8rpx;
}

/* 上传列表 */
.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* 上传项 */
.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.upload-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 删除按钮 */
.upload-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255, 0, 0, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 0, 0, 0.3);
}

/* 上传按钮 */
.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.upload-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.upload-btn text {
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  font-size: 20rpx;
}

/* 选择器容器 */
.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.picker-container:active {
  background: rgba(255, 255, 255, 0.3);
}

.picker-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 新旧程度列表 */
.condition-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

/* 新旧程度项 */
.condition-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.condition-item:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 新旧程度单选按钮 */
.condition-radio {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.condition-radio.active {
  border-color: #3498db;
  background: #3498db;
}

.condition-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.3s ease;
}

.condition-dot.active {
  background: #fff;
}

.condition-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 置换方式列表 */
.exchange-method-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 置换方式项 */
.exchange-method-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.exchange-method-item:active {
  background: rgba(255, 255, 255, 0.3);
}

/* 置换方式单选按钮 */
.exchange-method-radio {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.exchange-method-radio.active {
  border-color: #3498db;
  background: #3498db;
}

.exchange-method-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.3s ease;
}

.exchange-method-dot.active {
  background: #fff;
}

.exchange-method-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 提交发布区域 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(30rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 提交按钮 */
.submit-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
}

.draft-btn {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.preview-btn {
  background: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.publish-btn {
  background: linear-gradient(135deg, #3498db, #9b59b6);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
}

.submit-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* 提示信息区域 */
.tips-section {
  margin: 20rpx;
  width: calc(100% - 40rpx);
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
}

.tips-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.tips-content {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* 适配不同屏幕 */
@media screen and (max-width: 375px) {
  .section {
    margin: 16rpx;
    padding: 20rpx;
  }
  
  .form-input {
    height: 72rpx;
    font-size: 24rpx;
  }
  
  .submit-btn {
    height: 72rpx;
    font-size: 24rpx;
  }
  
  .upload-item,
  .upload-btn {
    width: 140rpx;
    height: 140rpx;
  }
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.loading text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-left: 12rpx;
}

/* 成功提示 */
.success-tip {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  z-index: 9999;
}

/* 图片预览样式 */
.preview-image {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.preview-image image {
  max-width: 90%;
  max-height: 90%;
}

/* 表单错误提示 */
.form-error {
  color: #ff6b6b;
  font-size: 20rpx;
  margin-top: 8rpx;
}