/* chat.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #3498db, #9b59b6);
  position: relative;
  overflow: hidden;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.back-arrow {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  margin-left: -6rpx;
  line-height: 1;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 20rpx 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 聊天消息区域 */
.chat-content {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 系统消息 */
.system-message {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.system-message text {
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
}

/* 消息行 */
.message-row {
  margin-bottom: 20rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  align-items: flex-end;
  max-width: 80%;
}

/* 自己的消息 */
.self-message {
  flex-direction: row-reverse;
  margin-left: auto;
}

/* 头像 */
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 消息内容 */
.message-content {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 84rpx);
}

/* 消息文本 */
.message-text {
  background: rgba(255, 255, 255, 0.9);
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  word-wrap: break-word;
}

.self-message .message-text {
  background: linear-gradient(135deg, #3498db, #9b59b6);
  color: #fff;
}

/* 消息时间 */
.message-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 6rpx;
  margin-left: 12rpx;
  align-self: flex-start;
}

.self-message .message-time {
  margin-left: 0;
  margin-right: 12rpx;
  align-self: flex-end;
}

/* 物品卡片 */
.item-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 24rpx;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.2);
}

/* 物品卡片头部 */
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
}

.item-status {
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.item-status.confirmed {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: #fff;
}

.item-status.completed {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
}

/* 物品信息 */
.item-info {
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
}

.item-info image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.item-details {
  flex: 1;
}

.item-name {
  font-size: 26rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 8rpx;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #f1c40f;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 4rpx rgba(241, 196, 15, 0.3);
}

.item-condition {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 物品操作按钮 */
.item-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.9);
  padding: 14rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3498db, #9b59b6);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* 快捷语提示 */
.quick-phrases {
  display: flex;
  overflow-x: auto;
  padding: 16rpx 20rpx;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.quick-phrases::-webkit-scrollbar {
  display: none;
}

.quick-phrase {
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.quick-phrase:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(30rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.input {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  padding: 0 10rpx;
  background: transparent;
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.input-tools {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.tool-item {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.tool-item:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.send-btn {
  background: linear-gradient(135deg, #3498db, #9b59b6);
  color: #fff;
  border: none;
  padding: 14rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
  transition: all 0.3s ease;
}

.send-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(52, 152, 219, 0.3);
}

.send-btn:disabled {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.6);
}

/* 适配不同屏幕 */
@media screen and (max-width: 375px) {
  .message-item {
    max-width: 85%;
  }
  
  .message-text {
    font-size: 24rpx;
  }
  
  .input {
    font-size: 24rpx;
  }
  
  .quick-phrase {
    font-size: 22rpx;
  }
}

/* 加载更多消息 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  text-align: center;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.9);
}

.empty-desc {
  font-size: 24rpx;
  opacity: 0.6;
  color: rgba(255, 255, 255, 0.7);
}